# Copy to .env.production on the server. Keep it out of git and backups shared publicly.
APP_ENV=production
HTTP_ADDR=:8080
DATABASE_PATH=/app/data/safe_route.db
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_TTL_HOURS=168
CORS_ORIGINS=
AI_API_URL=https://lenec.tech/v1/chat/completions
AI_API_TOKEN=
AI_MODEL=
AI_TIMEOUT_SECONDS=60
AI_ANALYZE_TIMEOUT_SECONDS=20
# Optional independent second provider. All three values are required.
AI_FALLBACK_API_URL=
AI_FALLBACK_API_TOKEN=
AI_FALLBACK_MODEL=
DEV_ADMIN_LOGIN=
DEV_ADMIN_PASSWORD=
